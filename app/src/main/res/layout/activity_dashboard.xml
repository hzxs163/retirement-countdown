<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/paper"
    android:fillViewport="true"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingLeft="12dp"
        android:paddingTop="12dp"
        android:paddingRight="12dp"
        android:paddingBottom="10dp">

        <!-- 顶部：今天剩余时分秒 + 出生→终点 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_dash_hero"
            android:orientation="vertical"
            android:paddingLeft="16dp"
            android:paddingTop="12dp"
            android:paddingRight="16dp"
            android:paddingBottom="14dp">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <TextView
                    android:id="@+id/dash_date"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="2026年11月20日 星期五"
                    android:textColor="#93A9B8"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/dash_settings"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="end|center_vertical"
                    android:background="?android:attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true"
                    android:paddingLeft="10dp"
                    android:paddingTop="4dp"
                    android:paddingRight="2dp"
                    android:paddingBottom="4dp"
                    android:text="设置"
                    android:textColor="#7E95A8"
                    android:textSize="11sp" />
            </FrameLayout>

            <TextView
                android:id="@+id/dash_clock"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:fontFamily="sans-serif-condensed"
                android:gravity="center"
                android:includeFontPadding="false"
                android:letterSpacing="0.05"
                android:text="17:00:11"
                android:textColor="#F5F8FA"
                android:textSize="38sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="出生"
                        android:textColor="#7E95A8"
                        android:textSize="10sp" />

                    <TextView
                        android:id="@+id/dash_birth"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="1dp"
                        android:maxLines="1"
                        android:text="1976年1月"
                        android:textColor="#F5F8FA"
                        android:textSize="13sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <com.hzxs163.retirement.TrackBarView
                    android:id="@+id/dash_track"
                    android:layout_width="0dp"
                    android:layout_height="22dp"
                    android:layout_marginLeft="12dp"
                    android:layout_marginRight="12dp"
                    android:layout_weight="1" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="end"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="终点"
                        android:textColor="#7E95A8"
                        android:textSize="10sp" />

                    <TextView
                        android:id="@+id/dash_end"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="1dp"
                        android:maxLines="1"
                        android:text="2036年1月"
                        android:textColor="#F5F8FA"
                        android:textSize="13sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- 出生年月 + 预期寿命 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_dash_card"
            android:elevation="1dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="14dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="出生年月"
                    android:textColor="@color/dash_muted"
                    android:textSize="11sp" />

                <LinearLayout
                    android:id="@+id/row_dash_birth"
                    android:layout_width="match_parent"
                    android:layout_height="42dp"
                    android:layout_marginTop="6dp"
                    android:background="@drawable/bg_input"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingLeft="12dp"
                    android:paddingRight="10dp">

                    <TextView
                        android:id="@+id/dash_birth_value"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:maxLines="1"
                        android:text="1976年01月"
                        android:textColor="@color/ink"
                        android:textSize="15sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🗓"
                        android:textSize="13sp" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginLeft="14dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/dash_life_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    android:text="预期寿命：78.6 岁"
                    android:textColor="@color/dash_muted"
                    android:textSize="11sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="42dp"
                    android:layout_marginTop="6dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <SeekBar
                        android:id="@+id/dash_life_seek"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_vertical"
                        android:layout_weight="1"
                        android:max="90" />

                    <TextView
                        android:id="@+id/dash_life_value"
                        android:layout_width="46dp"
                        android:layout_height="34dp"
                        android:layout_marginLeft="6dp"
                        android:background="@drawable/bg_pill"
                        android:gravity="center"
                        android:maxLines="1"
                        android:text="78.6"
                        android:textColor="@color/ink"
                        android:textSize="14sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- 已度过占比 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_dash_card"
            android:elevation="1dp"
            android:orientation="vertical"
            android:padding="14dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <FrameLayout
                    android:layout_width="104dp"
                    android:layout_height="104dp">

                    <com.hzxs163.retirement.DonutView
                        android:id="@+id/dash_donut"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:gravity="center"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/dash_used_percent"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="84.8%"
                            android:textColor="@color/dash_orange"
                            android:textSize="21sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/dash_used_caption"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="已度过"
                            android:textColor="@color/dash_muted"
                            android:textSize="10sp" />
                    </LinearLayout>
                </FrameLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="16dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <View
                            android:layout_width="8dp"
                            android:layout_height="8dp"
                            android:background="@color/dash_orange" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginLeft="6dp"
                            android:text="已度过"
                            android:textColor="@color/ink"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/dash_used_detail"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:text="50年 10个月 19天（18,586 天）"
                        android:textColor="@color/dash_muted"
                        android:textSize="11sp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <View
                            android:layout_width="8dp"
                            android:layout_height="8dp"
                            android:background="@color/dash_blue" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginLeft="6dp"
                            android:text="剩余"
                            android:textColor="@color/ink"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/dash_remain_detail"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:text="9年 2个月（3,328 天）"
                        android:textColor="@color/dash_muted"
                        android:textSize="11sp" />
                </LinearLayout>
            </LinearLayout>

            <com.hzxs163.retirement.TrackBarView
                android:id="@+id/dash_ring_track"
                android:layout_width="match_parent"
                android:layout_height="12dp"
                android:layout_marginTop="12dp" />
        </LinearLayout>

        <!-- 还能做多少次 -->
        <GridLayout
            android:id="@+id/dash_grid"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:columnCount="4"
            android:useDefaultMargins="false" />

        <!-- 图例 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:orientation="horizontal">

            <View
                android:layout_width="6dp"
                android:layout_height="6dp"
                android:background="@color/dash_blue" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="4dp"
                android:layout_marginRight="14dp"
                android:text="日常"
                android:textColor="@color/dash_muted"
                android:textSize="10sp" />

            <View
                android:layout_width="6dp"
                android:layout_height="6dp"
                android:background="@color/dash_pink" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="4dp"
                android:layout_marginRight="14dp"
                android:text="生理"
                android:textColor="@color/dash_muted"
                android:textSize="10sp" />

            <View
                android:layout_width="6dp"
                android:layout_height="6dp"
                android:background="@color/dash_orange" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="4dp"
                android:layout_marginRight="14dp"
                android:text="工作"
                android:textColor="@color/dash_muted"
                android:textSize="10sp" />

            <View
                android:layout_width="6dp"
                android:layout_height="6dp"
                android:background="@color/dash_green" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="4dp"
                android:text="季节"
                android:textColor="@color/dash_muted"
                android:textSize="10sp" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center"
            android:text="时光珍贵，活出精彩人生 🔥"
            android:textColor="@color/dash_muted"
            android:textSize="11sp"
            android:textStyle="italic" />
    </LinearLayout>
</ScrollView>
