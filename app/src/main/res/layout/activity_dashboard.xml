<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/paper"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingLeft="14dp"
        android:paddingTop="14dp"
        android:paddingRight="14dp"
        android:paddingBottom="22dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingBottom="10dp">

            <TextView
                android:id="@+id/dash_back"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingRight="14dp"
                android:paddingTop="4dp"
                android:paddingBottom="4dp"
                android:text="‹"
                android:textColor="@color/ink"
                android:textSize="26sp" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="生命仪表盘"
                android:textColor="@color/ink"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/dash_birth_inline"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="1976年1月"
                android:textColor="@color/muted"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- 顶部：当天剩余时分秒 + 出生→终点 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_dash_hero"
            android:orientation="vertical"
            android:paddingLeft="18dp"
            android:paddingTop="16dp"
            android:paddingRight="18dp"
            android:paddingBottom="16dp">

            <TextView
                android:id="@+id/dash_date"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="2026年11月20日 星期五"
                android:textColor="#A9BECB"
                android:textSize="12sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:letterSpacing="0.12"
                android:text="今天还剩"
                android:textColor="#7E95A8"
                android:textSize="10sp" />

            <TextView
                android:id="@+id/dash_clock"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:fontFamily="sans-serif-condensed"
                android:includeFontPadding="false"
                android:letterSpacing="0.06"
                android:gravity="center"
                android:text="17:00:11"
                android:textColor="#F5F8FA"
                android:textSize="42sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="出生"
                    android:textColor="#A9BECB"
                    android:textSize="10sp" />

                <TextView
                    android:id="@+id/dash_birth"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="6dp"
                    android:layout_weight="1"
                    android:text="1976年1月"
                    android:textColor="#F5F8FA"
                    android:textSize="12sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="终点"
                    android:textColor="#A9BECB"
                    android:textSize="10sp" />

                <TextView
                    android:id="@+id/dash_end"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="6dp"
                    android:text="2036年1月"
                    android:textColor="#F5F8FA"
                    android:textSize="12sp" />
            </LinearLayout>

            <com.hzxs163.retirement.TrackBarView
                android:id="@+id/dash_track"
                android:layout_width="match_parent"
                android:layout_height="26dp"
                android:layout_marginTop="2dp" />
        </LinearLayout>

        <!-- 出生年月 + 预期寿命 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_dash_card"
            android:orientation="vertical"
            android:padding="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="出生年月"
                        android:textColor="@color/dash_muted"
                        android:textSize="11sp" />

                    <LinearLayout
                        android:id="@+id/row_dash_birth"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:background="@drawable/bg_input"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingLeft="12dp"
                        android:paddingTop="10dp"
                        android:paddingRight="12dp"
                        android:paddingBottom="10dp">

                        <TextView
                            android:id="@+id/dash_birth_value"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:maxLines="1"
                            android:text="1976年01月"
                            android:textColor="@color/ink"
                            android:textSize="15sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="🗓"
                            android:textSize="13sp" />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="12dp"
                    android:layout_weight="1"
                    android:gravity="end"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/dash_life_label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="预期寿命：78 岁"
                        android:textColor="@color/dash_muted"
                        android:textSize="11sp" />

                    <TextView
                        android:id="@+id/dash_life_value"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:background="@drawable/bg_pill"
                        android:minWidth="48dp"
                        android:gravity="center"
                        android:paddingLeft="12dp"
                        android:paddingTop="8dp"
                        android:paddingRight="12dp"
                        android:paddingBottom="8dp"
                        android:text="78"
                        android:textColor="@color/ink"
                        android:textSize="15sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>

            <SeekBar
                android:id="@+id/dash_life_seek"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:max="90" />
        </LinearLayout>

        <!-- 已度过占比 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_dash_card"
            android:orientation="vertical"
            android:padding="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <FrameLayout
                    android:layout_width="122dp"
                    android:layout_height="122dp">

                    <com.hzxs163.retirement.DonutView
                        android:id="@+id/dash_donut"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:gravity="center"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/dash_used_percent"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="84.8%"
                            android:textColor="@color/dash_orange"
                            android:textSize="22sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/dash_used_caption"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="已度过"
                            android:textColor="@color/dash_muted"
                            android:textSize="10sp" />
                    </LinearLayout>
                </FrameLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="14dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <View
                            android:layout_width="8dp"
                            android:layout_height="8dp"
                            android:background="@color/dash_orange" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginLeft="6dp"
                            android:text="已度过"
                            android:textColor="@color/ink"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/dash_used_detail"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:layout_marginBottom="10dp"
                        android:text="50年 10个月 19天（18,586 天）"
                        android:textColor="@color/dash_muted"
                        android:textSize="11sp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <View
                            android:layout_width="8dp"
                            android:layout_height="8dp"
                            android:background="@color/dash_blue" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginLeft="6dp"
                            android:text="剩余"
                            android:textColor="@color/ink"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/dash_remain_detail"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="9年 2个月（3,328 天）"
                        android:textColor="@color/dash_muted"
                        android:textSize="11sp" />
                </LinearLayout>
            </LinearLayout>

            <com.hzxs163.retirement.TrackBarView
                android:id="@+id/dash_ring_track"
                android:layout_width="match_parent"
                android:layout_height="14dp"
                android:layout_marginTop="10dp" />
        </LinearLayout>

        <!-- 还能做多少次 -->
        <GridLayout
            android:id="@+id/dash_grid"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:columnCount="4"
            android:useDefaultMargins="false" />

        <!-- 图例 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center"
            android:orientation="horizontal">

            <View
                android:layout_width="7dp"
                android:layout_height="7dp"
                android:background="@color/dash_blue" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="4dp"
                android:layout_marginRight="12dp"
                android:text="日常"
                android:textColor="@color/dash_muted"
                android:textSize="10sp" />

            <View
                android:layout_width="7dp"
                android:layout_height="7dp"
                android:background="@color/dash_pink" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="4dp"
                android:layout_marginRight="12dp"
                android:text="生理"
                android:textColor="@color/dash_muted"
                android:textSize="10sp" />

            <View
                android:layout_width="7dp"
                android:layout_height="7dp"
                android:background="@color/dash_orange" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="4dp"
                android:layout_marginRight="12dp"
                android:text="工作"
                android:textColor="@color/dash_muted"
                android:textSize="10sp" />

            <View
                android:layout_width="7dp"
                android:layout_height="7dp"
                android:background="@color/dash_green" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="4dp"
                android:text="季节"
                android:textColor="@color/dash_muted"
                android:textSize="10sp" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:text="时光珍贵，活出精彩人生 🔥"
            android:textColor="@color/dash_muted"
            android:textSize="11sp" />
    </LinearLayout>
</ScrollView>
