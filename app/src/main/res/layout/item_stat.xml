<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_dash_card"
    android:elevation="1dp"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingLeft="6dp"
    android:paddingTop="6dp"
    android:paddingRight="6dp"
    android:paddingBottom="6dp">

    <FrameLayout
        android:layout_width="40dp"
        android:layout_height="40dp">

        <com.hzxs163.retirement.DonutView
            android:id="@+id/stat_ring"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <TextView
            android:id="@+id/stat_emoji"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="🍜"
            android:textSize="15sp" />
    </FrameLayout>

    <TextView
        android:id="@+id/stat_value"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:fontFamily="sans-serif-condensed"
        android:maxLines="1"
        android:text="9984"
        android:textColor="@color/ink"
        android:textSize="14sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/stat_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="1dp"
        android:maxLines="1"
        android:text="吃饭"
        android:textColor="@color/dash_muted"
        android:textSize="9sp" />

    <TextView
        android:id="@+id/stat_percent"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="1dp"
        android:maxLines="1"
        android:text="15%"
        android:textColor="@color/dash_blue"
        android:textSize="9sp" />
</LinearLayout>
