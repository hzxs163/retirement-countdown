<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_widget"
    android:orientation="vertical"
    android:paddingLeft="13dp"
    android:paddingTop="9dp"
    android:paddingRight="13dp"
    android:paddingBottom="7dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/widget_label"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:letterSpacing="0.04"
            android:maxLines="1"
            android:text="距离退休还有"
            android:textColor="#C9D8E2"
            android:textSize="11sp" />

        <LinearLayout
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:layout_marginLeft="9dp"
            android:layout_marginRight="8dp"
            android:orientation="vertical" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/widget_life_label"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:letterSpacing="0.04"
                android:maxLines="1"
                android:text="余生还有"
                android:textColor="@color/amber"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/widget_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_widget_badge"
                android:maxLines="1"
                android:paddingLeft="7dp"
                android:paddingTop="2dp"
                android:paddingRight="7dp"
                android:paddingBottom="2dp"
                android:text="男职工"
                android:textColor="@color/amber"
                android:textSize="9sp" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:gravity="top"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/retire_column"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="bottom"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/widget_days"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-condensed"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:text="1,234"
                android:textColor="@color/hero_text"
                android:textSize="32sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/widget_unit"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="4dp"
                android:layout_marginBottom="4dp"
                android:text="天"
                android:textColor="@color/hero_sub"
                android:textSize="11sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/widget_divider"
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:layout_marginLeft="9dp"
            android:layout_marginRight="8dp"
            android:layout_marginTop="2dp"
            android:background="#1FFFFFFF"
            android:orientation="vertical"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/life_column"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="start"
            android:orientation="vertical"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="bottom|start"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/widget_life_days"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-condensed"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:text="12,345"
                    android:textColor="@color/amber"
                    android:textSize="32sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/widget_life_unit"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="3dp"
                    android:layout_marginBottom="4dp"
                    android:text="天"
                    android:textColor="@color/amber"
                    android:textSize="11sp" />
            </LinearLayout>

            <Chronometer
                android:id="@+id/widget_life_chrono"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:format="%s"
                android:textColor="@color/amber"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/widget_line1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:text="预计 2050年3月12日 退休"
        android:textColor="#E8EFF4"
        android:textSize="11sp" />

    <TextView
        android:id="@+id/widget_line2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="1dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:text="还需 24 年 3 个月 · 63 岁退休"
        android:textColor="#9FB5C5"
        android:textSize="9sp" />

    <ViewFlipper
        android:id="@+id/widget_quote"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:autoStart="true"
        android:flipInterval="30000">

        <TextView
            android:id="@+id/widget_quote_1"
            style="@style/WidgetQuote"
            android:text="日子是过以后，不是过从前。" />

        <TextView
            android:id="@+id/widget_quote_2"
            style="@style/WidgetQuote"
            android:text="慢慢来，比较快。" />

        <TextView
            android:id="@+id/widget_quote_3"
            style="@style/WidgetQuote"
            android:text="心宽一寸，路宽一丈。" />

        <TextView
            android:id="@+id/widget_quote_4"
            style="@style/WidgetQuote"
            android:text="有茶有饭，便是好日。" />

        <TextView
            android:id="@+id/widget_quote_5"
            style="@style/WidgetQuote"
            android:text="忙时不慌，闲时不废。" />

        <TextView
            android:id="@+id/widget_quote_6"
            style="@style/WidgetQuote"
            android:text="一日三餐，四季安稳。" />
    </ViewFlipper>
</LinearLayout>